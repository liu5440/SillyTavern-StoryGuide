{
  "name": "sillytavern-story-guide",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "酒馆剧情指南：中文事件、分支与故事创作扩展",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write src tests scripts *.json *.ts *.js *.md docs .github style.css"
  },
  "dependencies": {
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "fake-indexeddb": "6.2.4",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
